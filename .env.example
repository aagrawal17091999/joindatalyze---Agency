# Public (exposed to browser) — prefix must be NEXT_PUBLIC_
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_SITE_URL=https://joindatalyze.com

# Tool download flow
TOOL_DOWNLOAD_TOKEN_SECRET=change-me-in-production

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Ghost (newsletter member sync)
GHOST_ADMIN_API_KEY=
GHOST_API_URL=https://datalyze.ghost.io

# BigQuery (tool download logging)
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET_ID=datalyze
# Inline service account JSON (single line, no newlines)
BIGQUERY_CREDENTIALS_JSON=
