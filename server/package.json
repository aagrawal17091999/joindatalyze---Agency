{
  "name": "datalyze-api",
  "version": "1.0.0",
  "description": "Datalyze API with MySQL and Firebase Auth",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "db:create": "sequelize-cli db:create"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.2.0",
    "firebase-admin": "^12.6.0",
    "helmet": "^7.1.0",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.0"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.2"
  }
}
